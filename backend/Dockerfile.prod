FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o api ./cmd/api
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o seed ./cmd/seed

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata curl
RUN curl -L https://github.com/golang-migrate/migrate/releases/download/v4.18.1/migrate.linux-amd64.tar.gz | tar xvz -C /usr/local/bin
WORKDIR /app
COPY --from=builder /app/api .
COPY --from=builder /app/seed .
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/uploads ./uploads-seed
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh
EXPOSE 8080
CMD ["/app/entrypoint.sh"]
